{
  "name": "straight-up-edit",
  "version": "1.0.0",
  "private": true,
  "description": "Beat-locked lyric edit \u2014 Karan Aujla, Straight Up",
  "scripts": {
    "analyze": "python3 tools/analyze_audio.py",
    "studio": "remotion studio",
    "proof": "remotion render SyncProof out/sync-proof.mp4 --crf=20",
    "qa": "python3 tools/verify_sync.py && remotion render Main1x1 qa/preview-qa60.mp4 --scale=0.5 --props='{\"qa\":true}' --crf=16 --muted && python3 tools/verify_sync.py --video qa/preview-qa60.mp4 && bash tools/qa_stills.sh && python3 tools/motion_curve.py qa/preview-qa60.mp4 --own",
    "render:1x1": "remotion render Main1x1 out/straight-up_1x1_60fps.mp4 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --color-space=bt709",
    "render:9x16": "remotion render Main9x16 out/straight-up_9x16_60fps.mp4 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --color-space=bt709",
    "typecheck": "tsc --noEmit",
    "prepare-assets": "bash tools/prepare_assets.sh && bash tools/make_tail.sh",
    "timing:h1": "python3 tools/make_h1_timing.py",
    "render:1x1-30": "remotion render Main1x1At30 out/straight-up_1x1_30fps.mp4 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --color-space=bt709"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/fonts": "^4.0.535",
    "@remotion/media": "^4.0.535",
    "@remotion/media-utils": "^4.0.535",
    "@remotion/motion-blur": "^4.0.535",
    "@remotion/noise": "^4.0.535",
    "@remotion/paths": "^4.0.535",
    "@remotion/shapes": "^4.0.535",
    "d3-geo": "^3.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.535",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^7.0.2"
  }
}
